from abc import ABC, abstractmethod
class Customer:
    def __init__(self,customer_id,name,age,email,phonenumber,income,creditscore):
        self.customer_id=customer_id
        self.name=name
        self.age=age
        self.email=email
        self.phonenumber=phonenumber
        self.income=income
        self.creditscore=creditscore
    def check_eligibility(self):
        if self.age<21 or self.creditscore<650 or self.income<25000:
            return False
        return True
    def display_customer(self):
        print("\nCustomer Details")
        print("---------------------")
        print("Customer_id: ",self.customer_id)
        print("Name :",self.name)
        print("Age :",self.age)
        print("Email: ",self.email)
        print("Phonenumber :",self.phonenumber)
        print("Income :",self.income)
        print("Creditscore: ",self.creditscore)
